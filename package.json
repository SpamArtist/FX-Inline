{
  "name": "FX Inline",
  "private": true,
  "description": "FX Inline converts prices directly on webpages into your preferred currency, so you can compare costs without leaving the page.",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "backend:build": "tsc -p backend/tsconfig.json",
    "backend:start": "npm run backend:build && node backend/dist/server.js",
    "build:unit": "tsc -p apps/extension/tsconfig.unit.json",
    "jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:frontend": "npm run build:unit && npm run jest -- apps/extension/tests/unit",
    "test:unit": "npm run test:frontend",
    "test:backend": "npm run backend:build && npm run jest -- backend/tests",
    "test:all": "npm run test:frontend && npm run test:backend",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@tailwindcss/vite": "^4.1.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vite-plugin-svgr": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@wxt-dev/module-react": "^1.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.1",
    "wxt": "^0.20.6"
  }
}
