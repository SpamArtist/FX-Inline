views {
  view index {
    title 'FX Inline Landscape'
    include *
  }

  view repo_overview of fx_inline_repository {
    title 'FX Inline Repository Overview'
    include *
  }

  view extension_runtime of fx_inline_repository.extension_app {
    title 'Browser Extension Overview'
    include *
  }

  view content_pipeline of fx_inline_repository.extension_app.content_runtime {
    title 'Content Runtime Pipeline'
    include *
  }

  view website_overview of fx_inline_repository.website_app {
    title 'Website And Playground'
    include *
  }

  dynamic view selection_conversion_flow {
    title 'Selection Conversion Flow'

    browser_user -> visited_web_pages 'selects a price on the page'
    browser_platform -> fx_inline_repository.extension_app.content_runtime.content_script 'inject content runtime'
    fx_inline_repository.extension_app.content_runtime.content_script -> fx_inline_repository.extension_app.content_runtime.currency_parsing_utils 'parse selected text'
    fx_inline_repository.extension_app.content_runtime.content_script -> fx_inline_repository.extension_app.content_runtime.selection_popup_loader 'load popup controller'
    fx_inline_repository.extension_app.content_runtime.selection_popup_loader -> fx_inline_repository.extension_app.content_runtime.selection_popup 'mount popup UI'
    fx_inline_repository.extension_app.content_runtime.selection_popup -> fx_inline_repository.extension_app.browser_storage 'read settings and rates'

    include
      visited_web_pages,
      fx_inline_repository.extension_app.browser_storage
  }

  dynamic view rate_refresh_flow {
    title 'Rate Refresh Flow'

    browser_platform -> fx_inline_repository.extension_app.background_worker 'startup, install, or alarm event'
    fx_inline_repository.extension_app.background_worker -> fx_inline_repository.extension_app.rate_client 'refresh rate snapshot'
    fx_inline_repository.extension_app.rate_client -> exchange_rate_providers 'fetch latest USD rates'
    fx_inline_repository.extension_app.rate_client -> fx_inline_repository.extension_app.browser_storage 'update rate cache'

    include fx_inline_repository.extension_app.browser_storage
  }
}
