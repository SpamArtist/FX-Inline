{
  "name": "@fx-inline/inline-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Shared inline conversion runtime for extension and embeddable HTML script usage.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./extension": {
      "types": "./src/index.d.ts",
      "import": "./src/extension.js",
      "default": "./src/extension.js"
    },
    "./global": {
      "import": "./src/global.js",
      "default": "./src/global.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "./src/global.js"
  ],
  "dependencies": {
    "@fx-inline/currency-detection": "file:../currency-detection"
  },
  "engines": {
    "node": ">=20"
  }
}
