{
  "name": "@fx-inline/currency-detection",
  "version": "0.1.0",
  "private": true,
  "description": "Portable currency and amount detection/parsing core with strict legacy parity.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./iso-data": {
      "types": "./src/iso-data.d.ts",
      "import": "./src/iso-data.js",
      "default": "./src/iso-data.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
