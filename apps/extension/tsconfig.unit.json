{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "./test-dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "utils/utils.ts",
    "utils/constants.ts",
    "utils/enums.ts",
    "utils/rateMath.ts",
    "utils/ratePolicy.ts"
  ]
}
