{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "./test-dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "utils/utils.ts",
    "utils/constants.ts",
    "utils/currencyPresentation.ts",
    "utils/enums.ts",
    "utils/inlineRuntimeSettings.ts",
    "utils/inlineRuntimeSettings.types.ts",
    "utils/installLifecycle.ts",
    "utils/localStorage.ts",
    "utils/localStorage.types.ts",
    "utils/mutationRoots.ts",
    "utils/rateMath/index.ts",
    "utils/ratePolicy/index.ts",
    "hooks/useCurrencyReducer.state.ts",
    "hooks/useCurrencyReducer.hydration.ts"
  ]
}
